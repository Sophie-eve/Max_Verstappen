# ==============================================================================
# MAX VERSTAPPEN FAN SITE - ENVIRONMENT VARIABLES
# ==============================================================================
# Duplicate this file to '.env.local' and provide your project keys:
# cp .env.example .env.local

# 1. Supabase Project URL (Found under Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Key (Public key safe for browser/API route)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Supabase Service Role Key (Optional: Server-only key with elevated rights)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# ADMIN NOTE ON VIEWING FAN SUBMISSIONS:
# 1. Open your Supabase Dashboard: https://supabase.com/dashboard/project/_
# 2. Click on "Table Editor" in the left sidebar
# 3. Click on the "fan_signups" table
# 4. You will see every registered fan with Name, Email, Country, Moment, and Message!
# 5. Click "Export to CSV" anytime you want to extract your fan mailing list.
# ------------------------------------------------------------------------------
